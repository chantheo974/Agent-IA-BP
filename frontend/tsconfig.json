{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/cockpit/*"],
      "next/link": ["./src/cockpit/link.tsx"],
      "next/navigation": ["./src/cockpit/router.tsx"]
    }
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests"],
  "exclude": ["src/cockpit/components/ui/message-scroller.tsx"]
}
